# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Fuel Finder OAuth client ID (from the Fuel Finder developer portal). Not secret.
# The client SECRET does not go here: put it in ./secrets/fuel_finder_client_secret,
# which compose mounts into the container as a Docker secret.
FUEL_FINDER_CLIENT_ID=

# Comma-separated "label:sha256hex" entries. Create one with:
#   docker compose run --rm --no-deps mcp gen-token --label my-laptop
# The token itself goes to your MCP client; only its hash goes here.
FUEL_MCP_AUTH_TOKEN_HASHES=

# Host port (bound to 127.0.0.1 only).
MCP_PORT=8000

# MCP server image. Pin a release tag or digest for reproducible deployments.
# MCP_IMAGE=ghcr.io/beecho01/fuel-prices-mcp:1.0.0

# If clients reach the server under another name (e.g. via a reverse proxy), add it here,
# otherwise requests are rejected by DNS-rebinding protection (HTTP 421/403).
# FUEL_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,mcp.example.internal
# FUEL_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*

# OAuth 2.1 resource-server mode (instead of static tokens):
# FUEL_MCP_OAUTH_ISSUER=https://auth.example.com/realms/main
# FUEL_MCP_OAUTH_JWKS_URL=https://auth.example.com/realms/main/protocol/openid-connect/certs
# FUEL_MCP_OAUTH_RESOURCE_URL=https://mcp.example.com/mcp
# FUEL_MCP_OAUTH_REQUIRED_SCOPES=fuelprices:read

# Force all outbound traffic through an allowlisting proxy (only the two upstream hosts):
# FUEL_MCP_EGRESS_PROXY=http://egress-proxy:4750

# FUEL_MCP_RATE_LIMIT_PER_MINUTE=60
# FUEL_MCP_LOG_LEVEL=INFO
